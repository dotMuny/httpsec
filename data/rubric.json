{
  "schema_version": 1,
  "name": "httpsec default rubric",
  "version": "1.0.0",
  "notes": "Weights are relative; the final score is the earned fraction of the applicable weight, expressed out of 100. Controls whose evidence could not be gathered (for example TLS controls in --headers-only mode) are dropped from both sides of the fraction so they neither help nor hurt.",
  "severity_penalty": {
    "critical": 1.0,
    "high": 0.8,
    "medium": 0.5,
    "low": 0.25,
    "info": 0.0,
    "pass": 0.0
  },
  "controls": [
    {"id": "csp.present",         "category": "csp",     "weight": 10, "title": "A Content-Security-Policy is enforced"},
    {"id": "csp.script-src",      "category": "csp",     "weight": 10, "title": "Script sources are restricted"},
    {"id": "csp.frame-ancestors", "category": "csp",     "weight": 4,  "title": "Framing is restricted by CSP"},
    {"id": "csp.base-uri",        "category": "csp",     "weight": 3,  "title": "base-uri is restricted"},
    {"id": "csp.object-src",      "category": "csp",     "weight": 3,  "title": "Plugin content is blocked"},
    {"id": "csp.default-src",     "category": "csp",     "weight": 3,  "title": "A restrictive default-src exists"},
    {"id": "csp.style-src",       "category": "csp",     "weight": 2,  "title": "Style sources are restricted"},
    {"id": "hsts",                "category": "headers", "weight": 10, "title": "HTTP Strict Transport Security"},
    {"id": "nosniff",             "category": "headers", "weight": 4,  "title": "MIME sniffing is disabled"},
    {"id": "referrer-policy",     "category": "headers", "weight": 4,  "title": "Referrer leakage is controlled"},
    {"id": "xfo",                 "category": "headers", "weight": 3,  "title": "Legacy framing protection"},
    {"id": "permissions-policy",  "category": "headers", "weight": 3,  "title": "Powerful features are restricted"},
    {"id": "coop",                "category": "headers", "weight": 3,  "title": "Cross-origin opener isolation"},
    {"id": "coep",                "category": "headers", "weight": 2,  "title": "Cross-origin embedder policy"},
    {"id": "corp",                "category": "headers", "weight": 2,  "title": "Cross-origin resource policy"},
    {"id": "cors",                "category": "headers", "weight": 8,  "title": "CORS configuration"},
    {"id": "legacy-headers",      "category": "headers", "weight": 3,  "title": "No withdrawn security headers"},
    {"id": "info-headers",        "category": "info",    "weight": 3,  "title": "No version disclosure"},
    {"id": "cookies",             "category": "cookies", "weight": 8,  "title": "Cookie attributes"},
    {"id": "tls.versions",        "category": "tls",     "weight": 12, "title": "TLS protocol versions"},
    {"id": "tls.certificate",     "category": "tls",     "weight": 12, "title": "Certificate and chain"},
    {"id": "tls.ciphers",         "category": "tls",     "weight": 8,  "title": "Cipher suite selection"},
    {"id": "tls.extras",          "category": "tls",     "weight": 3,  "title": "TLS protocol hardening"},
    {"id": "tls.ocsp",            "category": "tls",     "weight": 2,  "title": "OCSP stapling"},
    {"id": "redirect",            "category": "network", "weight": 8,  "title": "HTTP to HTTPS upgrade"},
    {"id": "mixed-content",       "category": "network", "weight": 5,  "title": "No mixed content"},
    {"id": "http-methods",        "category": "network", "weight": 3,  "title": "HTTP methods"},
    {"id": "security-txt",        "category": "network", "weight": 1,  "title": "Disclosure contact published"}
  ],
  "caps": [
    {"finding": "tls.handshake.failed",                  "max_grade": "F", "reason": "The host does not complete a TLS handshake at all."},
    {"finding": "tls.cert.expired",                      "max_grade": "F", "reason": "An expired certificate breaks the site for every visitor."},
    {"finding": "tls.cert.not-yet-valid",                "max_grade": "F", "reason": "A certificate outside its validity window is rejected by clients."},
    {"finding": "tls.cert.hostname-mismatch",            "max_grade": "F", "reason": "A certificate that does not cover the hostname authenticates nothing."},
    {"finding": "tls.cert.self-signed",                  "max_grade": "F", "reason": "A self-signed certificate chains to no trusted root."},
    {"finding": "tls.cert.untrusted-chain",              "max_grade": "F", "reason": "The chain does not verify against the system trust store."},
    {"finding": "tls.cert.revoked",                      "max_grade": "F", "reason": "A revoked certificate must be replaced immediately."},
    {"finding": "tls.cert.weak-signature",               "max_grade": "D", "reason": "SHA-1 and MD5 signatures are forgeable in practice."},
    {"finding": "cors.reflects-origin-with-credentials", "max_grade": "D", "reason": "Any website can read this origin's authenticated responses."},
    {"finding": "cors.wildcard-with-credentials",        "max_grade": "D", "reason": "The CORS layer is configured to expose credentialed responses to any origin."},
    {"finding": "redirect.no-https",                     "max_grade": "D", "reason": "Content served over plain HTTP can be read and rewritten in transit."},
    {"finding": "tls.cipher.insecure",                   "max_grade": "C", "reason": "A cipher suite that is broken in practice is accepted."},
    {"finding": "tls.compression.enabled",               "max_grade": "C", "reason": "TLS compression enables the CRIME attack."},
    {"finding": "tls.version.tls10",                     "max_grade": "C", "reason": "TLS 1.0 is deprecated by RFC 8996."},
    {"finding": "tls.version.tls11",                     "max_grade": "B", "reason": "TLS 1.1 is deprecated by RFC 8996."}
  ],
  "grades": [
    {"grade": "A+", "min_score": 95},
    {"grade": "A",  "min_score": 90},
    {"grade": "B+", "min_score": 85},
    {"grade": "B",  "min_score": 80},
    {"grade": "C+", "min_score": 75},
    {"grade": "C",  "min_score": 70},
    {"grade": "D+", "min_score": 65},
    {"grade": "D",  "min_score": 60},
    {"grade": "F",  "min_score": 0}
  ]
}
